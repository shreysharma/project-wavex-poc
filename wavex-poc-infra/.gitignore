# Terraform files and directories
.terraform/
.terraform.*
**/.terraform/*
*.tfstate
*.tfstate.*
*.terraform.lock.hcl
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.example.*

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore tfplan files
*.tfplan
*.plan

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore Mac .DS_Store files
.DS_Store

# Ignore sensitive environment files
.env
.env.*

# Ignore any backup files
*.backup
*.bak

# Ignore temporary files
*.tmp
*.temp
.claude/